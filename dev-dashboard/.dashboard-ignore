# dev-dashboard/.dashboard-ignore
# 内部工程路径清单：命中即视为「已归置」（不是产品事实，不该出现在仪表盘上）。
# 语义：`*` 不跨目录、`**` 跨目录、`?` 单字符、大小写敏感、不支持 [abc] 字符类。

# ── 工程脚手架与依赖清单 ─────────────────────────────
app/.gitignore
app/.metadata
app/analysis_options.yaml
app/pubspec.*
app/README.md
app/PORTING-NOTES.md
app/android/**
app/ios/**

# ── 素材与字体（设计素材，不是功能）──────────────────
app/assets/fonts/**
prototype/opus-v2-dir/fonts/**

# ── 单元测试（内部工程；产品表现不靠它背书）──────────
app/test/*

# ── 内部工具与格式化助手 ─────────────────────────────
app/lib/data/format.dart
tools/**
prompts/**

# ── 团队施工账本（谁认领了哪张卡，是过程记录不是产品事实）──
.agent-teams/**

# ── 第三方播放器与授权文件（版权红线，模型本体不入库）──
prototype/opus-v2-dir/vendor/**

# ── Live2D 模型数据本体（版权素材、格式转换产物与对照模型）──
# 2026-10-09 起随仓库分发（宿主决定），但仍属「她的身体数据」：
# 换模型不改产品行为，逐文件收录只会把功能地图淹掉。
# 产品事实以「功能: 她本人（Live2D 角色）」的证据与 app/STAGE-OPTIONS.md 为准。
app/assets/live2d/**

