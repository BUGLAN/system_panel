# 依赖（可重装，不入库）
node_modules/

# 构建产物
dist/
dev-dist/
*.tsbuildinfo
.vite/
coverage/

# 凭据与本机环境：任何 Key 都不入库
.env
.env.*
*.local

# 音效合成脚本的中间产物（wav 原件，转码后的成品放 public/audio/ 入库）
tools/audio/.out/

# 日志与系统杂项
*.log
.DS_Store

# Claude Code 本机状态
.claude/worktrees/
.claude/settings.local.json
.claude/launch.json

# 服务端数据（SQLite 数据库、上传的证据照片、快照）与备份：永不入库
data/
backups/
