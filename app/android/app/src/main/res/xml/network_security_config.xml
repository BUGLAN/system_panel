<?xml version="1.0" encoding="utf-8"?>
<!--
  只给本机回环地址开明文 http 的口子。

  为什么需要：舞台页（路线 ②）由 App 自己起的迷你 HTTP 服务提供 ——
  地址是 `http://127.0.0.1:<随机端口>/`。Android 9 起默认禁止明文流量，
  不开这个口子 WebView 会直接加载失败。

  ⚠️ 只放行回环地址，不要图省事写 `android:usesCleartextTraffic="true"` ——
     那等于对全网开放明文，没必要。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
