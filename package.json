{
  "name": "host-system",
  "private": true,
  "version": "0.2.0",
  "description": "宿主养成系统 · 服务器 + SQLite 多用户全栈",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w @host/web --",
    "dev:server": "tsx watch --clear-screen=false --env-file-if-exists=.env apps/server/src/main.ts",
    "build": "npm run build -w @host/web && npm run build -w @host/server",
    "start": "node --env-file-if-exists=.env apps/server/dist/main.mjs",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p apps/web && tsc --noEmit -p apps/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && vitest run && npm run build && node scripts/check-dist.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "admin": "tsx --env-file-if-exists=.env apps/server/src/cli/admin.ts",
    "db:generate": "npm run db:generate -w @host/server",
    "icons": "npm run icons -w @host/web && node scripts/splash.mjs",
    "splash": "node scripts/splash.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
